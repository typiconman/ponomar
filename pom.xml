<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.ponomar</groupId>
    <artifactId>ponomar</artifactId>
    <version>0.0.45-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <junit.version>6.1.3</junit.version>
    </properties>

    <build>
        <sourceDirectory>${project.basedir}</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/java</testSourceDirectory>
        <resources>
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>Ponomar/images/**</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>${project.basedir}/Ponomar/scripts/Perl/data</directory>
                <targetPath>regression</targetPath>
                <filtering>false</filtering>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion><version>[17,)</version></requireJavaVersion>
                                <requireMavenVersion><version>[3.9.0,)</version></requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>UTF-8</encoding>
                    <includes>
                        <include>Ponomar/*.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <argLine>@{argLine} -Dfile.encoding=UTF-8</argLine>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <parallel>none</parallel>
                    <useModulePath>false</useModulePath>
                    <systemPropertyVariables>
                        <user.timezone>UTC</user.timezone>
                        <java.awt.headless>true</java.awt.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest><mainClass>Ponomar.Main</mainClass></manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check-core-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <includes>
                                        <include>Ponomar.JDate</include>
                                        <include>Ponomar.Paschalion</include>
                                        <include>Ponomar.OrderedHashtable</include>
                                        <include>Ponomar.StringOp</include>
                                        <include>Ponomar.QDParser</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>BUNDLE</element>
                                    <includes>
                                        <include>Ponomar.Astronomy</include>
                                        <include>Ponomar.Commemoration</include>
                                        <include>Ponomar.Commemoration1</include>
                                        <include>Ponomar.ConfigurationFiles</include>
                                        <include>Ponomar.CreateIndex*</include>
                                        <include>Ponomar.CreateTables</include>
                                        <include>Ponomar.Day</include>
                                        <include>Ponomar.Fasting</include>
                                        <include>Ponomar.JavaFileFilter</include>
                                        <include>Ponomar.JDate</include>
                                        <include>Ponomar.Kahuna*</include>
                                        <include>Ponomar.LanguagePack</include>
                                        <include>Ponomar.MenologionReader*</include>
                                        <include>Ponomar.OrderedHashtable*</include>
                                        <include>Ponomar.PCalendar</include>
                                        <include>Ponomar.Paschalion</include>
                                        <include>Ponomar.QDParser</include>
                                        <include>Ponomar.ReadText</include>
                                        <include>Ponomar.Reporter</include>
                                        <include>Ponomar.RuleBasedNumber</include>
                                        <include>Ponomar.Service</include>
                                        <include>Ponomar.ServiceInfo</include>
                                        <include>Ponomar.StringOp</include>
                                        <include>Ponomar.Sunrise</include>
                                        <include>Ponomar.TypiconMenologion</include>
                                        <include>Ponomar.UsualBeginning</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
